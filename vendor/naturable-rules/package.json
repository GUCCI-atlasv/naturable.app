{
  "name": "naturable-rules",
  "version": "1.2.0",
  "description": "Open, explainable rules for spotting AI-sounding writing patterns (English + Chinese beta). Runs locally; no upload. Not an AI detector.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./packs/en.json": "./packs/en.json",
    "./packs/zh.json": "./packs/zh.json",
    "./dist/*": "./dist/*"
  },
  "bin": {
    "naturable-check": "./skill/scripts/naturable-check.mjs"
  },
  "files": ["src", "packs", "schema", "dist", "skill", "LICENSE", "LICENSE-DATA.md"],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "check": "npm run validate && npm test && npm run build"
  },
  "engines": { "node": ">=18.20" },
  "keywords": ["ai writing", "writing style", "ai words to avoid", "linter", "prose", "agent skill"],
  "license": "MIT AND CC-BY-4.0",
  "homepage": "https://naturable.app",
  "bugs": { "url": "https://github.com/GUCCI-atlasv/naturable-rules/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/GUCCI-atlasv/naturable-rules.git" },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
