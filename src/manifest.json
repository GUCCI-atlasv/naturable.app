{
  "manifest_version": 3,
  "name": "Naturable – AI Writing Pattern Checker",
  "short_name": "Naturable",
  "version": "0.1.0",
  "description": "Underlines AI writing patterns (AI words, template openers, em dashes) where you type. Runs locally; nothing is uploaded.",
  "homepage_url": "https://naturable.app/en/chrome-extension/",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Naturable",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "contextMenus", "sidePanel", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
