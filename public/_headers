# Cloudflare Pages headers (copied into out/ via Next public/ export)

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/en/*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/zh-cn/*
  Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
