{
  "name": "naturable-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Naturable for Chrome: underlines AI writing patterns where you type. MV3, runs locally.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test --test-concurrency=1 test/*.test.mjs",
    "pack": "node scripts/check.mjs && node scripts/pack.mjs"
  },
  "engines": { "node": ">=20.10" },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
